{
  "name": "radium-engine",
  "version": "0.1.0",
  "private": true,
  "description": "RadiumEngine — a component based 2D/3D map and geo-object framework (Leaflet + MapLibre/three.js, terrain, offline tile cache, Tauri friendly)",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run build --workspace @radium-engine/core && node scripts/check-core.mjs && node scripts/check-camera.mjs && node scripts/check-settings.mjs && node scripts/check-interaction.mjs && node scripts/check-package.mjs",
    "check:core": "npm run build --workspace @radium-engine/core && node scripts/check-core.mjs",
    "check:camera": "npm run build --workspace @radium-engine/core && node scripts/check-camera.mjs",
    "check:settings": "npm run build --workspace @radium-engine/core && node scripts/check-settings.mjs",
    "check:interaction": "npm run build --workspace @radium-engine/core && node scripts/check-interaction.mjs",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "playground": "npm --workspace apps/playground run dev",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}